# Anthropic API key used by the Coder agent (required for real runs and the smoke test)
ANTHROPIC_API_KEY=

# Folder under which each task gets its own new workspace
WORKSPACE_ROOT=workspace

# Local folder for the embedded Chroma memory store
CHROMA_PATH=.chroma

# Chroma server host; leave empty to use the embedded store at CHROMA_PATH
CHROMA_HOST=

# Chroma server port (only used when CHROMA_HOST is set)
CHROMA_PORT=8000

# Seconds before a run of generated code is killed
EXEC_TIMEOUT_SECONDS=30

# Characters kept from each of stdout and stderr of a run
MAX_OUTPUT_CHARS=10000

# Characters of a tool result shown to the model per observation
MAX_OBSERVATION_CHARS=4000

# Number of recent ReAct turns kept in the sliding-window buffer
MEMORY_WINDOW_TURNS=6

# Maximum past-context records retrieved from Chroma before each LLM call
MEMORY_TOP_K=4

# Maximum embedding distance for a retrieved record to count as relevant
MEMORY_MAX_DISTANCE=1.2

# Maximum output tokens per model call (large enough for whole-file writes)
LLM_MAX_TOKENS=8192

# Retries the Anthropic client makes before a model call fails
LLM_MAX_RETRIES=2

# Logging level (DEBUG shows retrieved past context)
LOG_LEVEL=INFO
